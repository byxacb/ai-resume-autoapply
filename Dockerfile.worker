# Dockerfile.worker - runs auto_job Selenium worker
FROM python:3.12-slim

WORKDIR /app

# Install Chrome + dependencies for undetected-chromedriver
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    chromium-driver \
    xvfb \
    libxss1 \
    libnss3 \
    libatk-bridge2.0-0 \
    libgtk-3-0 \
    libgbm1 \
    fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*

ENV CHROME_BIN=/usr/bin/chromium

# Install Python deps
COPY orchestrator/requirements.txt /app/orchestrator/requirements.txt
COPY auto_job/requirements.txt /app/auto_job/requirements.txt
RUN pip install --no-cache-dir -r /app/orchestrator/requirements.txt \
    && pip install --no-cache-dir -r /app/auto_job/requirements.txt

# Copy code
COPY orchestrator/ /app/orchestrator/
COPY auto_job/auto_job_find/ /app/auto_job/auto_job_find/

CMD ["python", "-m", "orchestrator.auto_job_worker"]
